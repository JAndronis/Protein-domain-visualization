# Inputs and rendered outputs (InterProScan/UniProt JSON, feature tables, figures)
*.json
*.csv
*.svg

# Python and build artifacts
__pycache__/
*.py[cod]
build/
dist/
*.egg-info/

# Hidden files and directories: .venv, .ruff_cache, .vscode, .claude, .DS_Store,
# ._* (macOS), .Trash-*, .directory, .nfs*, .fuse_hidden* (Linux)
.*
!.gitignore
!.python-version

# Editor backups and non-hidden OS files
*~
*.swp
Icon?
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk
