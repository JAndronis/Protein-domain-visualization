# Inputs and rendered outputs (InterProScan/UniProt JSON, feature tables, figures)
*.json
*.csv
*.svg

# Python and build artifacts
__pycache__/
*.py[cod]
build/
dist/
*.egg-info/

# Extra files and dirs: .venv, .ruff_cache, .vscode, .claude, .DS_Store,
# ._* (macOS), .Trash-*, .directory, .nfs*, .fuse_hidden* (Linux)
.*
!.gitignore
!.python-version
*~
*.swp
Icon?
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# Test fixtures and goldens are tracked; the built static site is not
!tests/
!tests/**
site/
tests/**/__pycache__/
